# Laravel API (backend-laravel, `php artisan serve`)
API_BASE_URL=http://localhost:8000/api

# Optional \u2014 Firebase project used as the supplementary *online* data store
# (recent search history + a realtime notifications mirror). Leave blank to
# run purely against the local Laravel + MySQL/SQL stack; the app detects
# missing config and silently disables the Firebase-backed features.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
