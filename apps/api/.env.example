# =============================================================================
#  EDU-SMART API — environment template
#  Copy to .env (`copy .env.example .env`) and run `php artisan key:generate`.
# =============================================================================

APP_NAME="EDU-SMART"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost:8000

# Origin of the React web client (apps/web) — used by CORS and reset links.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Microsoft SQL Server (system of record) ---------------------------------
# Default: SQL Server Express LocalDB + Windows authentication.
#   SSMS → Server name: (localdb)\MSSQLLocalDB  → Authentication: Windows.
# For a full SQL Server / Express instance with SQL authentication use e.g.
#   DB_HOST=localhost  DB_PORT=1433  DB_USERNAME=sa  DB_PASSWORD=...
# LocalDB does not support TLS on its local pipe, so DB_ENCRYPT=no here;
# use DB_ENCRYPT=yes for any networked SQL Server.
DB_CONNECTION=sqlsrv
DB_HOST='(localdb)\MSSQLLocalDB'
DB_PORT=
DB_DATABASE=EduSmart
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true

# --- Cache / session / queue ---------------------------------------------------
# The API is stateless (Sanctum bearer tokens); file cache + sync queue keep
# the stack dependency-free. Switch QUEUE_CONNECTION=database for a worker.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Authentication ------------------------------------------------------------
# Personal access token lifetime in minutes (default 7 days). Empty = never.
SANCTUM_EXPIRATION=10080
# Failed logins allowed per minute per email+IP before throttling.
AUTH_LOGIN_ATTEMPTS=5

# --- Uploads -----------------------------------------------------------------
UPLOAD_MAX_MB=25

# --- Mail (password reset) — logged to storage/logs by default ----------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@edusmart.lk"
MAIL_FROM_NAME="${APP_NAME}"

# --- Firebase (realtime layer: notifications, activity feed, live study) -----
# Local development uses the Firebase Emulator Suite with a "demo-" project id,
# which needs no Google account or credentials (`npm run firebase:emulators`).
# For a real Firebase project: set FIREBASE_PROJECT_ID, point
# FIREBASE_CREDENTIALS at the service-account JSON and blank the emulator hosts.
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=demo-edusmart
FIREBASE_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Optional semantic search engine (services/ai-engine, Python) ---------------
# When reachable, chatbot retrieval is re-ranked with sentence-transformers;
# otherwise the built-in BM25 engine is used. Leave empty to disable.
AI_ENGINE_URL=http://127.0.0.1:8001
AI_ENGINE_TIMEOUT=6

# --- Optional LLM answer writer (any OpenAI-compatible chat endpoint) ----------
# Off by default — every feature works with the built-in NLP engine. When
# enabled, chatbot answers and summaries are rewritten from retrieved sources.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
