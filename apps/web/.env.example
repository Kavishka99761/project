# EDU-SMART web client — copy to .env.local to override.

# Laravel API (apps/api) base URL, including the version prefix.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Firebase web config. With the local Emulator Suite these can stay as-is:
# the project id and emulator hosts come from the API (/firebase/token).
# For a real Firebase project paste the values from
# Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
