APP_NAME="EDU-SMART"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Origin of the web frontend (used by config/cors.php)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8.0+) -------------------------------------------
# Create the schema first:  mysql -u root -p < database/sql/schema.sql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edu_smart
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / Session / Queue -----------------------------------------
# File + sync drivers keep the app runnable with only the EDU-SMART tables.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# --- Filesystem -------------------------------------------------------
FILESYSTEM_DISK=local

# --- Mail (logged to file by default) ---------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@edusmart.lk"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum ----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:19006
