# ------------------------------------------------------------------
#  AcadeAlert — root ignore
#  Layer-specific ignores live in apps/api/, apps/web/ and
#  apps/mobile/. This file covers cross-cutting OS/editor noise.
# ------------------------------------------------------------------

# Dependencies & build output
node_modules/
dist/
dist-verify/
build/
.expo/
vendor/
.venv/
__pycache__/
*.py[cod]

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*.swo
*~

# Local scratch
*.tmp
.cache/
# Throwaway verification harnesses and their captures (created, run, deleted)
.verify-*
